# Trend Copilot Environment Variables

# SQLite Database Location
DB_PATH=data/agent.db
DB_TIMEOUT_SECONDS=10.0

# Ingestion Pipeline Thresholds
MIN_VELOCITY_SCORE=60.0
DEDUP_WINDOW_HOURS=48
TOP_TRENDS_LIMIT=5
SIMILARITY_THRESHOLD=75.0
BREAKING_VELOCITY_THRESHOLD=75.0
BREAKING_MAX_AGE_HOURS=2.0
CROSS_SOURCE_BOOST=15.0

# Network Settings
REQUEST_TIMEOUT_SECONDS=15.0

# Google Trends Collector Settings
GOOGLE_TRENDS_GEO=US
GOOGLE_TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo={geo}
GOOGLE_TRENDS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Reddit API Credentials (Optional: required for Reddit hot-thread monitoring)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trend_copilot:v0.1.0 (by /u/trend_copilot_bot)
REDDIT_POST_LIMIT=25

# Hacker News Collector Settings
HACKERNEWS_TOP_STORIES_LIMIT=30
HACKERNEWS_MIN_SCORE=100
HACKERNEWS_MAX_AGE_HOURS=4.0
HACKERNEWS_CONCURRENCY=10
